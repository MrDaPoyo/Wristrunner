prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: libalpm
Description: Arch Linux package management library
URL: http://archlinux.org/pacman/
Version: 16.0.1
Requires.private: libcrypto, libarchive >= 3.0.0, libcurl >= 7.55.0, libseccomp, gpgme >= 1.18.0
Libs: -L${libdir} -lalpm
Cflags: -I${includedir} -D_FILE_OFFSET_BITS=64
